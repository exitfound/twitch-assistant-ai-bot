# Только секреты, числа и флаги. Тексты бота — в CONTENT.md.

# ---------- Обязательные ----------
TWITCH_CLIENT_ID=your_client_id
TWITCH_CLIENT_SECRET=your_client_secret
TWITCH_BOT_ID=your_bot_user_id
TWITCH_CHANNEL=your_channel_name
GEMINI_API_KEY=your_gemini_api_key

# Заполняются после первой OAuth-авторизации (значения печатаются в консоль)
TWITCH_BOT_TOKEN=
TWITCH_BOT_REFRESH=
# Токен владельца канала — только для наград за баллы канала. Ссылку на
# авторизацию бот пишет в лог при запуске, войти нужно под аккаунтом канала
TWITCH_BROADCASTER_TOKEN=
TWITCH_BROADCASTER_REFRESH=

# ---------- Логирование ----------
# LOG_LEVEL по умолчанию INFO для бота и WARNING для CLI-команд
LOG_LEVEL=INFO
# LOG_FILE пуст — пишем только в консоль
LOG_FILE=
LOG_FILE_MAX_BYTES=5000000
LOG_FILE_BACKUPS=3

# ---------- Gemini ----------
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=1.5
# 0 — выключено, -1 — решает модель, >0 — бюджет в токенах
GEMINI_THINKING_BUDGET=0
GEMINI_CONCURRENCY=5
GEMINI_TIMEOUT=60
# Повторы только на транзиентных ошибках (429/5xx/сеть), таймаут не повторяется
GEMINI_RETRIES=2

# ---------- Ответы в чат ----------
# Вероятности задаются в процентах 0..100
CAPS_PROBABILITY=30
EMOTE_PROBABILITY=10
# Максимум сообщений, на которые режется длинный ответ (!ask, !summary)
CHAT_MAX_CHUNKS=3

# ---------- Кулдауны ----------
# Одна лесенка на все команды. Стример, модераторы и подписчики не ждут
# никогда — это правило, значений для них нет
COOLDOWN_VIP=10
COOLDOWN_REGULAR=30

# ---------- Контекст для Gemini ----------
CONTEXT_CHAT_MESSAGES=50
CONTEXT_SEARCH_RESULTS=10
# Какая доля результатов поиска отводится лору (остальное — история чата)
CONTEXT_SEARCH_KNOWLEDGE_SHARE=50
CONTEXT_KNOWLEDGE_RANDOM=10
CONTEXT_WHO_MESSAGES=30
CONTEXT_VERSUS_MESSAGES=30
CONTEXT_SUMMARY_MESSAGES=500
CONTEXT_USER_INTERACTIONS=10

# ---------- Проактивные сообщения ----------
PROACTIVE_ENABLED=true
PROACTIVE_INTERVAL_MINUTES=15
# Из скольких последних сообщений выбирается активный зритель
PROACTIVE_ACTIVE_WINDOW=20
# Шанс, что реплика будет адресной, а не общей
PROACTIVE_TARGET_PROBABILITY=50

# ---------- Эфир ----------
# Сессия бота — это эфир. Оборвался и снова пошёл за столько минут — тот же эфир
STREAM_RESUME_MINUTES=15

# ---------- Игра !roll ----------
ROLL_MIN=1
ROLL_MAX=100
# Бесплатных !roll на зрителя за сессию, дальше — награда «Доп. ролл» за баллы.
# Стример катает без лимита
ROLL_FREE_PER_SESSION=3
# Итоги прошлого эфира: китежанину щит от перебросов, залупе проклятие.
# Отсчёт минут идёт с первого появления человека в чате нового эфира
ROLL_PERKS_ENABLED=true
ROLL_PERK_MINUTES=30

# ---------- Награды за баллы канала ----------
# Доп. ролл, переброс и проклятие чужого ролла, щит. Бот создаёт их в Twitch
# сам и сам подтверждает или возвращает баллы. Без токена канала не работают
REWARDS_ENABLED=true
# Цены в баллах. Зритель без подписки зарабатывает около 300 в час
REWARD_COST_EXTRA=100
REWARD_COST_REROLL=250
REWARD_COST_CURSE=1000
REWARD_COST_SHIELD=500
# Проклятие: бросок жертвы не выше CEILING, каждый её следующий бросок опускает
# потолок на STEP до FLOOR. На дне держится HOLD_MINUTES, потом проклятие спадает
REWARD_CURSE_CEILING=75
REWARD_CURSE_STEP=5
REWARD_CURSE_FLOOR=25
REWARD_CURSE_HOLD_MINUTES=15
# Сколько минут цель неуязвима для перебросов после первого переброса по ней.
# Проклятие защиту пробивает. 0 — без защиты
REWARD_REROLL_PROTECT_MINUTES=3
# Сколько раз один зритель может перебросить и проклясть за эфир. 0 — без лимита
REWARD_ATTACK_MAX_PER_USER=3

# ---------- Спам эмотами ----------
EMOTE_SPAM_ENABLED=false
EMOTE_SPAM_INTERVAL_MINUTES=10
EMOTE_SPAM_MIN=1
EMOTE_SPAM_MAX=5
