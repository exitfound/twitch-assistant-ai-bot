# Только секреты, числа и флаги. Тексты бота – в CONTENT.md.

# ---------- Обязательные ----------
TWITCH_CLIENT_ID=your_client_id
TWITCH_CLIENT_SECRET=your_client_secret
TWITCH_BOT_ID=your_bot_user_id
TWITCH_CHANNEL=your_channel_name
GEMINI_API_KEY=your_gemini_api_key

# Запасные: OAuth-вход (make oauth) пишет токены в data/.tio.tokens.json, и бот
# берёт их оттуда. Эти значения – только если в файле токена нет
TWITCH_BOT_TOKEN=
TWITCH_BOT_REFRESH=
# Токен владельца канала – только для наград за баллы канала. Ссылку на
# авторизацию бот пишет в лог при запуске, войти нужно под аккаунтом канала
TWITCH_BROADCASTER_TOKEN=
TWITCH_BROADCASTER_REFRESH=

# ---------- Пути к файлам ----------
# Пусто – база в корне проекта, тексты в docs/CONTENT.md. В Docker базу задаёт compose:
# данные должны жить на томе, а не внутри образа
BOT_DB_PATH=
BOT_CONTENT_PATH=
# Модели ruaccent для голоса (ё и ударения). Пусто – каталог ruaccent/ в корне проекта,
# модели скачиваются при первом запуске. Образ Docker несёт их с собой и задаёт путь сам
BOT_ACCENT_PATH=
# Часовой пояс: по нему именуются сессии и разговоры памяти и ставится время
# в логах, в какой бы зоне ни работал процесс. Неизвестное имя останавливает запуск
BOT_TIMEZONE=Europe/Moscow

# ---------- Логирование ----------
# LOG_LEVEL по умолчанию INFO для бота и WARNING для CLI-команд
LOG_LEVEL=INFO
# LOG_FILE пуст – лог идёт только в stdout. В Docker он остаётся пустым: вывод
# забирает docker logs, ротацию задаёт демон, а второй приёмник логов молча
# отваливается вместе с примонтированным каталогом
LOG_FILE=
LOG_FILE_MAX_BYTES=5000000
LOG_FILE_BACKUPS=3

# ---------- Gemini ----------
GEMINI_MODEL=gemini-3.8-flash
# Выше 1.4 Flash начинает ломать падежи и сыпать обрывками контекста, ниже 1.3 ответы пресные
GEMINI_TEMPERATURE=1.4
# !ask – режим фактов: ниже температура, меньше выдумок
GEMINI_ASK_TEMPERATURE=0.5
# 0 – выключено, -1 – решает модель, >0 – бюджет в токенах
# Общий для чата и памяти. Pro работает только с thinking: для неё 0 – ошибка API
GEMINI_THINKING_BUDGET=0
GEMINI_CONCURRENCY=5
GEMINI_TIMEOUT=60
# Повторы только на транзиентных ошибках (429/5xx/сеть), таймаут не повторяется
GEMINI_RETRIES=2
# Весь ответ в чат целиком, сек: очередь к Gemini, повторы, паузы и ступени лестницы.
# GEMINI_TIMEOUT ограничивает один запрос, память дедлайна не имеет
GEMINI_ANSWER_DEADLINE=30

# ---------- Ответы в чат ----------
# Вероятности задаются в процентах 0..100
CAPS_PROBABILITY=30
EMOTE_PROBABILITY=10
# Максимум сообщений, на которые режется длинный ответ (!ask, !summary)
CHAT_MAX_CHUNKS=2

# ---------- Кулдауны ----------
# Одна лесенка на все команды. Стример, модераторы и подписчики не ждут
# никогда – это правило, значений для них нет
COOLDOWN_VIP=5
COOLDOWN_REGULAR=15
# Справки и команды канала (!help, !bot, !channel, !tg …): каждая раз в столько секунд
# на весь чат, повтор бот молча пропускает; личной паузы у них нет. Стример и модераторы
# без паузы, 0 – выкл
COOLDOWN_PUBLIC=30

# ---------- Лимиты обращений к Gemini ----------
# Потолок за окно поверх кулдауна, растёт по лестнице статусов. Модератор без сабки
# между VIP и подписчиком, стример не ограничен. 0 – без лимита
QUOTA_SUB_PER_HOUR=100
QUOTA_MOD_PER_HOUR=75
QUOTA_VIP_PER_HOUR=50
QUOTA_FOLLOWER_PER_HOUR=25
QUOTA_WINDOW_MINUTES=60
# Общий потолок канала за окно: аварийный тормоз по расходам, чтобы и несколько
# человек вместе не закрыли бота остальным. Стримера не держит и не считает.
# 0 – без ограничения
QUOTA_CHANNEL_PER_HOUR=200

# ---------- Фолов ----------
# Без фолова бот не отвечает вовсе, кроме !help, !bot, !channel и команд канала,
# а награды за баллы канала возвращают баллы
FOLLOW_REQUIRED=true
# Сколько минут помнить ответ Twitch о том, фолловер ли зритель
FOLLOW_CACHE_MINUTES=15
# Как часто повторять одному человеку предложение зафоловиться
FOLLOW_HINT_MINUTES=10

# ---------- Контекст для Gemini ----------
# Сколько последних сообщений свободный ответ и проактив видят как есть – нить разговора.
# Остальной чат приходит пересказом (пульс, хроника): сырые строки бот вставляет кусками
CONTEXT_CHAT_MESSAGES=20
# Фактов досье спрашивающего в свободном ответе; у названных в вопросе людей вдвое меньше
CONTEXT_DOSSIER_FACTS=6
# !summary берёт стрим целиком; это только предохранитель на случай бесконечного стрима
# (самый длинный стрим – 1521 сообщение)
CONTEXT_STREAM_MAX_MESSAGES=2000
# Бюджет чата !summary в одном запросе, символов: от него зависит счёт.
# Самый длинный стрим – 61 тыс. символов, обычный – 15–25 тыс.
CONTEXT_STREAM_MAX_CHARS=60000
CONTEXT_SEARCH_RESULTS=10
# Какая доля результатов поиска отводится лору (остальное – история чата)
CONTEXT_SEARCH_KNOWLEDGE_SHARE=50
CONTEXT_KNOWLEDGE_RANDOM=10
# !who: на каждый вызов свежая случайная выборка из досье человека – шапка,
# CONTEXT_WHO_FACTS фактов, коронные фразы, пара отношений, последние сообщения.
# CONTEXT_WHO_MESSAGES – его последние сообщения (из них CONTEXT_WHO_RECENT_MESSAGES
# идут в выборку, все – на запасную ступень). !versus берёт половину на каждого
CONTEXT_WHO_MESSAGES=30
CONTEXT_WHO_FACTS=8
CONTEXT_WHO_RECENT_MESSAGES=10
CONTEXT_WHO_RELATIONS=2
CONTEXT_VERSUS_MESSAGES=30
# !summary берёт весь стрим; если Gemini его блокирует – столько последних сообщений
CONTEXT_SUMMARY_MESSAGES=500
CONTEXT_USER_INTERACTIONS=10

# ---------- Память о чатерсах ----------
# После каждого разговора в чате Gemini пишет его хронику и дополняет досье
# активных зрителей. Историю целиком – один раз: bot.py --build-memory
MEMORY_ENABLED=true
# Разговор закончен, когда чат молчит столько минут. Статус стрима не важен:
# вне стримов здесь не пишут, так что разговор – это и есть стрим
MEMORY_SILENCE_MINUTES=180
# Разговор короче этого не получает хроники и не обновляет досье
MEMORY_CONVERSATION_MIN_MESSAGES=50
# Со скольких сообщений за разговор у зрителя заводится или обновляется досье
MEMORY_PROFILE_MIN_MESSAGES=10
# Активных фактов в досье одного зрителя: сверх лимита выключаются наименее подтверждённые
MEMORY_DOSSIER_MAX_FACTS=40

# ---------- Пульс чата ----------
# Пересказ того, о чём чат говорит прямо сейчас, в 3–5 строк. Свободные ответы и проактив
# видят его вместо сырого чата стрима. Пересобирается во время эфира раз в
# PULSE_INTERVAL_MINUTES, пока в чате пишут; пульс старше двух интервалов не используется
PULSE_ENABLED=true
PULSE_INTERVAL_MINUTES=5
PULSE_MESSAGES=150

# ---------- Напоминание о командах ----------
# Бот сам напоминает в чат про !bot и !channel: только пока идёт эфир и только
# если в чате кто-то писал. Текст – ключ help_announce в CONTENT.md
HELP_ANNOUNCE_ENABLED=true
HELP_ANNOUNCE_INTERVAL_MINUTES=20

# ---------- Проактивные сообщения ----------
PROACTIVE_ENABLED=true
# Пауза до следующей реплики берётся случайно из диапазона: ровный интервал
# читается как расписание. PROACTIVE_INTERVAL_MINUTES тоже принимается
# и означает ровный интервал
PROACTIVE_INTERVAL_MIN_MINUTES=5
PROACTIVE_INTERVAL_MAX_MINUTES=30
# Из скольких последних сообщений выбирается активный зритель
PROACTIVE_ACTIVE_WINDOW=20
# Шанс, что реплика будет адресной, а не общей
PROACTIVE_TARGET_PROBABILITY=50

# ---------- Лимит за стрим ----------
# !ask, !who, !versus, !summary, !ascii и !clip: сколько раз зритель вызывает каждую
# за стрим (вне эфира – за сутки), счёт у каждой команды свой. У фолловера это
# пробный раз: после него бот предлагает подписку. Модератор между VIP и сабом;
# VIP и модератор с сабкой считаются сабом, стример не ограничен, 0 – без лимита
PER_STREAM_FOLLOWER=1
PER_STREAM_VIP=5
PER_STREAM_MOD=7
PER_STREAM_SUB=10

# ---------- Картинки в брайль (!ascii) ----------
# Команда !ascii <ссылка>: бот скачивает картинку и рисует её символами
# Брайля одним сообщением. Ссылку даёт зритель, поэтому ограничено всё
PICTURE_ENABLED=true
# Таймаут одной операции скачивания, секунды; на всё скачивание – вдвое больше
PICTURE_TIMEOUT=10
# Потолок размера файла, байты (10 МБ)
PICTURE_MAX_BYTES=10485760
# Ширина арта в символах. Строка должна влезать в колонку чата целиком:
# шире – порвётся переносом и картинка разъедется
PICTURE_MAX_COLS=26
# Поправка на пропорции ячейки чата: символ Брайля выше, чем вдвое своей
# ширины, поэтому без сжатия картинка выглядит вытянутой. Меньше 1 – сжать
PICTURE_ASPECT=0.8
# Выедать заливку: сплошное пятно теряет форму, от него остаются края.
# Тонкие линии не страдают – они сами края
PICTURE_HOLLOW=true
# Насколько тёмные места остаются залитыми поверх контура – это даёт
# объём. Больше – больше заливки, 0 – только контур
PICTURE_SHADOW=45
# Показывать картинку Gemini: он решает, можно ли её показывать, и описывает её
PICTURE_CHECK=true

# ---------- Клипы !clip ----------
# Команда !clip [секунды] [название]: клип последних секунд эфира от имени бота,
# в чат – ссылка. Токену бота нужно право clips:edit (make oauth)
CLIP_ENABLED=true
# Длина без числа и самый короткий клип, секунды, 5–60. Зритель видит эфир
# с задержкой, поэтому слишком короткий клип промахивается мимо момента
CLIP_DEFAULT_SECONDS=30
CLIP_MIN_SECONDS=10

# ---------- Эфир ----------
# Сессия бота – это эфир. Оборвался и снова пошёл за столько минут – тот же эфир
STREAM_RESUME_MINUTES=15

# ---------- Игра !roll ----------
# Границы броска; перепутанные местами переставляются сами
ROLL_MIN=1
ROLL_MAX=100
# Бесплатных !roll на зрителя за сессию, дальше – награда «Доп. ролл» за баллы.
# Стример катает без лимита
ROLL_FREE_PER_SESSION=3
# Бесплатные броски по статусу: випка, модерка и подписка дают больше
ROLL_FREE_VIP=5
ROLL_FREE_MOD=7
ROLL_FREE_SUB=10
# Итоги прошлого эфира: китежанину щит от перебросов, залупе проклятие.
# Отсчёт минут идёт с первого появления человека в чате нового эфира
ROLL_PERKS_ENABLED=true
ROLL_PERK_MINUTES=60
# Тормоз спама: если последние ROLL_BURST_THROWS своих бросков игрока (!roll и доп. роллы
# вместе) уложились в ROLL_BURST_SECONDS, следующий откроется через ROLL_BURST_PAUSE_MINUTES
# после последнего. Стример не ограничен
ROLL_BURST_THROWS=5
ROLL_BURST_SECONDS=60
ROLL_BURST_PAUSE_MINUTES=1
# Игра на экране стрима: страница для OBS (Browser Source 1920×1080) http://<сервер>:<MASCOT_PORT>/roll/
# и её события. Отдаётся на порту оверлеев вместе с маскотом; работает и без MASCOT_ENABLED
ROLL_OVERLAY_ENABLED=false

# ---------- Награды за баллы канала ----------
# Доп. ролл, переброс и проклятие чужого ролла, щит, очищение. Бот создаёт их в Twitch
# сам и сам подтверждает или возвращает баллы. Без токена канала не работают
REWARDS_ENABLED=true
# Цены в баллах. Зритель без подписки зарабатывает около 300 в час
REWARD_COST_EXTRA=100
REWARD_COST_REROLL=250
REWARD_COST_CURSE=750
REWARD_COST_SHIELD=500
REWARD_COST_CLEANSE=1000
# Проклятие: бросок жертвы не выше CEILING, каждый её следующий бросок опускает
# потолок на STEP до FLOOR. На дне держится HOLD_MINUTES, потом проклятие спадает.
# STEP не меньше 1: с нулём потолок не доходит до дна и проклятие длится весь эфир
REWARD_CURSE_CEILING=75
REWARD_CURSE_STEP=10
REWARD_CURSE_FLOOR=25
REWARD_CURSE_HOLD_MINUTES=30
# Сколько минут цель неуязвима для перебросов после первого переброса по ней.
# Проклятие защиту пробивает. 0 – без защиты
REWARD_REROLL_PROTECT_MINUTES=1
# Сколько перебросов, щитов, проклятий и очищений может купить один зритель – по статусу из
# его сообщений в чате этого эфира (не писал – как фолловер): перебросов за окно REWARD_REROLL_WINDOW_MINUTES,
# остальных за стрим. Окно открывает первый удачный переброс, первый переброс после
# окна открывает новое. Стример не ограничен, 0 – без лимита. Лимит Twitch на эфир у этих наград поэтому 0 (ниже)
REWARD_LIMIT_FOLLOWER=3
REWARD_LIMIT_VIP=5
REWARD_LIMIT_MOD=7
REWARD_LIMIT_SUB=10
REWARD_REROLL_WINDOW_MINUTES=30
# Сколько минут держится купленный щит, от момента покупки
REWARD_SHIELD_MINUTES=30
# «Очищение»: сколько минут очищенного нельзя проклясть снова
REWARD_CLEANSE_PROTECT_MINUTES=30
# Сколько раз один зритель может купить каждую награду за эфир (считает Twitch).
# 0 – без лимита. Лимит, выставленный вручную в панели Twitch, при запуске вернётся к этим
REWARD_EXTRA_MAX_PER_USER=0
REWARD_REROLL_MAX_PER_USER=0
REWARD_CURSE_MAX_PER_USER=0
REWARD_SHIELD_MAX_PER_USER=0
REWARD_CLEANSE_MAX_PER_USER=0

# ---------- Спам эмотами ----------
EMOTE_SPAM_ENABLED=false
# Тоже случайно из диапазона
EMOTE_SPAM_INTERVAL_MIN_MINUTES=5
EMOTE_SPAM_INTERVAL_MAX_MINUTES=20
EMOTE_SPAM_MIN=1
EMOTE_SPAM_MAX=5

# ---------- Маскот: оверлей OBS по настроению чата ----------
# Бот считает разных пишущих за окно (стример и сам бот тоже считаются) и отдаёт
# настроение странице в OBS по SSE: http://<сервер>:<порт>/mascot/events
MASCOT_ENABLED=false
# Адрес и порт оверлеев OBS – маскота и игры (ROLL_OVERLAY_ENABLED), которые слушает процесс. Бот, запущенный на хосте (make oauth, отладка),
# слушает только себя; в контейнере compose ставит 0.0.0.0 сам
MASCOT_HOST=127.0.0.1
MASCOT_PORT=8787
# Адрес хоста, на котором compose публикует порт. По умолчанию 127.0.0.1 – оверлей с другой
# машины до бота не достучится. 0.0.0.0 – все интерфейсы: контейнер поднимется при любом
# адресе сервера. Конкретный адрес строже, но если его нет при старте (DHCP выдал другой или
# ещё не выдал), не поднимется весь бот, а не только оверлей
MASCOT_PUBLISH=127.0.0.1
# Зритель держится в подсчёте столько секунд после своего последнего сообщения
MASCOT_WINDOW_SECONDS=300
# С какого числа разных пишущих маскот садится, встаёт и танцует (меньше SIT – лежит).
# Должны расти: SIT < STAND < DANCE
MASCOT_SIT=3
MASCOT_STAND=5
MASCOT_DANCE=8
# Вниз – на одну позу не чаще раза в столько секунд; вверх – сразу
MASCOT_STEP_DOWN_SECONDS=60
# Танец быстрее на 0.1 за каждого сверх MASCOT_DANCE, но не больше этого
MASCOT_MAX_RATE=1.5

# ---------- Discord: голос бота ----------
# Токен бота из Discord Developer Portal (вкладка Bot). Пусто – бот в Discord не заходит.
# Нужен включённый Message Content Intent
DISCORD_TOKEN=
# ID из Discord с режимом разработчика: правой кнопкой → Копировать ID.
# Текстовый канал для команд, голосовой канал (сервер бот берёт из него), сам владелец
DISCORD_TEXT_CHANNEL_ID=
DISCORD_VOICE_CHANNEL_ID=
DISCORD_OWNER_ID=
# Роли, которым кроме владельца доступны !join, !leave, !voice: ID через запятую
# (Настройки сервера → Роли → правой кнопкой → Копировать ID). Кому можно – решается
# выдачей роли в Discord, без перезапуска бота. Пусто – только владелец
DISCORD_COMMAND_ROLE_IDS=
# Библиотека Opus, которой discord.py кодирует голос: имя или путь. По умолчанию libopus.so.0
# из системы; образ задаёт свой путь сам – в .env для контейнера не указывать
# DISCORD_OPUS_LIB=libopus.so.0
# TTS-сервер (Qwen3-TTS-Openai-Fastapi или другой с /v1/audio/speech и потоковым PCM 24 кГц).
# Пусто – Discord без голоса
VOICE_TTS_URL=
# Голос на сервере: clone:<профиль>
VOICE_TTS_VOICE=clone:kael_low
# Голос включён, пока его ни разу не переключали !voice: дальше бот помнит выбор сам
VOICE_ENABLED=true
# Озвучивать ответы бота в Twitch, пока он в голосовом канале
VOICE_TWITCH=true
# Длиннее – озвучивается до конца последнего предложения в пределах этого числа символов.
# 500 – целиком одно сообщение Twitch
VOICE_MAX_CHARS=500
# Темп речи: выше 1 – быстрее, ниже – медленнее, высота голоса та же (0.8–1.25).
# Клон говорит в темпе своего образца, а `speed` сервера в потоке не действует, поэтому
# темп меняет бот
VOICE_TEMPO=1.0
# Перед синтезом ruaccent ставит «ё»: модель угадывает ударение по написанию, и «все»
# вместо «всё» – её частая ошибка
VOICE_YO=true
# Отмечать ударение в каждом слове (заглавной ударной гласной: «замОк»). Модель слушается
# такой пометки не во всех словах, а речь от неё медленнее – по умолчанию выключено.
# Отдельные слова лучше чинить словарём lists.voice_words в CONTENT.md
VOICE_STRESS=false
# Синтезировать ответ по предложениям, а не целиком: каждый запрос начинает модель
# заново, и интонация длинного ответа не сползает к концу
VOICE_SENTENCES=true
# Сколько речи накопить перед началом: не меньше VOICE_PREBUFFER_SECONDS секунд, а для
# длинного ответа – VOICE_PREBUFFER_SHARE процентов его ожидаемой длины. Бот поднимает
# запас под скорость сервера, которую меряет сам: без запаса длинный ответ заикается
VOICE_PREBUFFER_SECONDS=2
VOICE_PREBUFFER_SHARE=25
# Сколько ответов ждёт озвучки; новый сверх этого пропускается
VOICE_QUEUE=15
# Ответ, ждавший озвучки дольше стольких секунд, пропускается: в активном чате бот
# физически не успевает проговорить всё, и голос не должен отставать от чата на минуты
VOICE_MAX_WAIT_SECONDS=180
# Предел на один ответ: от запроса до последнего байта речи, секунды. Для длинной фразы
# предел больше – её ожидаемая длина × 3 + 30 с
VOICE_TIMEOUT=120
