# The hall server's settings: copy to kinozal/.env on the server (chmod 600), fill in, then docker compose up.
# docker-compose.yml marks the required ones as ${VAR:?}: the stack does not start without them. docs/KINOZAL.md
# Comments stay on lines of their own: kinozal.sh reads a value up to the end of its line

# ---------- secrets of this server: generate once, keep only here ----------
# openssl rand -hex 16; Owncast's admin login is "admin"
OWNCAST_ADMIN_PASSWORD=
# openssl rand -hex 16; the key for OBS Branch Output
OWNCAST_STREAM_KEY=
# openssl rand -hex 32; signs the cookies and the OBS dock link
GATE_SECRET=

# ---------- the site ----------
# The hall's domain without https://; the bot's FILM_URL is https://<this domain>
KINOZAL_DOMAIN=
# The channel whose followers and subs get in, the bot's TWITCH_CHANNEL
TWITCH_CHANNEL=
# The bot's FILM_API_TOKEN (openssl rand -hex 24): the same value on both sides
GATE_API_TOKEN=

# ---------- the hall's own Twitch app (dev.twitch.tv); both empty – entry by the code only ----------
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ---------- optional ----------
# Digits in a session code
GATE_CODE_LEN=4
# A session closes this many seconds after the bot's last call; 0 – never
# GATE_LEASE_SECONDS=180
